# Copy this file to .env locally, or add these variables in Render's Environment settings.
# Never commit real values. For Gmail, SMTP_PASSWORD must be a Google App Password.
DATABASE_URL=
DB_SSL=false
PORT=3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=CarnegienFreedom <your-sender@example.com>

# Optional one-time emergency admin bootstrap. Set these only in your private .env.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# The bootstrap account is the super admin and must approve new admin accounts.
